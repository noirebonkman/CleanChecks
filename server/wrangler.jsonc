{
  "name": "cleanchecks",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "assets": {
    "directory": "../.server-build/v0.99919",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cleanchecks",
      "database_id": "2f74db10-5530-4d2f-be22-0cdfc5acc8a6",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "REQUIRE_TURNSTILE": "true"
  },
  "observability": {
    "enabled": false
  },
  "secrets": {
    "required": [
      "APP_DATA_KEY",
      "SETUP_TOKEN"
    ]
  },
  "preview_urls": false,
  "account_id": "2d8f60bf4123c9779769b8244e3af291",
  "triggers": {
    "crons": [
      "0 * * * *"
    ]
  },
  "ratelimits": [
    {
      "name": "AUTH_REQUEST_LIMITER",
      "namespace_id": "54681001",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "API_REQUEST_LIMITER",
      "namespace_id": "54681002",
      "simple": {
        "limit": 1200,
        "period": 60
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CALENDAR_EVENTS",
        "class_name": "CalendarEvents"
      }
    ]
  },
  "migrations": [
    {
      "tag": "calendar-events-v1",
      "new_sqlite_classes": [
        "CalendarEvents"
      ]
    }
  ]
}
