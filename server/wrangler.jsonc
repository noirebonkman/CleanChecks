{
  "name": "cleanchecks",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "assets": {
    "directory": "../.server-build/v0.992",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cleanchecks",
      "database_id": "2f74db10-5530-4d2f-be22-0cdfc5acc8a6",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {},
  "observability": {
    "enabled": false
  },
  "secrets": {
    "required": [
      "APP_DATA_KEY",
      "SETUP_TOKEN"
    ]
  },
  "preview_urls": false,
  "account_id": "2d8f60bf4123c9779769b8244e3af291",
  "triggers": {
    "crons": [
      "0 * * * *"
    ]
  }
}
