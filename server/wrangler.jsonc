{
  "name": "cleanchecks",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "assets": {
    "directory": "../.server-build/v0.94",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cleanchecks",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {},
  "observability": {
    "enabled": false
  },
  "secrets": {
    "required": [
      "APP_DATA_KEY",
      "SETUP_TOKEN"
    ]
  },
  "preview_urls": false
}
