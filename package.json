{
  "name": "lucent-inspection",
  "private": true,
  "version": "0.94",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5179",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5179",
    "test": "node --max-old-space-size=384 tests/verify-app.mjs && node tests/deployment-assets.mjs",
    "server:install": "npm --prefix server ci",
    "server:dev": "node tools/start-local-server.mjs",
    "server:test": "npm --prefix server test",
    "server:deploy": "npm run server:build && node tools/check-server-deployment.mjs && npm --prefix server run deploy",
    "server:build": "npm run build && node tools/prepare-server-assets.mjs",
    "server:check": "node tools/check-server-deployment.mjs --dry-run && npm --prefix server run deploy:check"
  },
  "dependencies": {
    "dexie": "^4.0.11",
    "html-to-image": "^1.11.13",
    "jspdf": "^3.0.0",
    "jszip": "^3.10.2",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.11",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "axe-core": "^4.14.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.3",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^0.21.0"
  }
}
